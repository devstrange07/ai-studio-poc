# ── LLM credentials (fill in what you use) ──────────────────────────────────
# Sample workflow uses provider: openai — OPENAI_API_KEY is enough to run.

OPENAI_API_KEY=

# Azure OpenAI (optional — for llmProfiles with provider azure-openai)

AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=2025-04-01-preview

# Google Gemini (optional — for llmProfiles with provider google-gemini)
GEMINI_API_KEY=
